{"pack":"bcs-bank-math","subject":"গণিত","chapter":"বীজগণিত","hash":"3199171f2928","questions":[{"id":"bcs-bank-math-da609ec8d036","subject":"গণিত","chapter":"বীজগণিত","q":"x + 1/x = 4 হলে x² + 1/x² এর মান কত?","o":["১২","১৮","১৬","১৪"],"a":3,"d":2,"src":"নিজস্ব রচনা","sol":["x² + 1/x² = (x + 1/x)² − 2 = ১৬ − ২ = ১৪"],"kind":"math"},{"id":"bcs-bank-math-09d0da1c266c","subject":"গণিত","chapter":"বীজগণিত","q":"a − b = 3 এবং ab = 10 হলে a² + b² এর মান কত?","o":["৩৯","১৯","২৯","৪৯"],"a":2,"d":2,"src":"নিজস্ব রচনা","sol":["a² + b² = (a − b)² + 2ab = ৯ + ২০ = ২৯"],"kind":"math"},{"id":"bcs-bank-math-a9eb849b9a2d","subject":"গণিত","chapter":"বীজগণিত","q":"x² − 7x + 12 এর উৎপাদক কোনটি?","o":["(x − 3)(x − 4)","(x − 2)(x − 6)","(x − 1)(x − 12)","(x + 3)(x + 4)"],"a":0,"src":"নিজস্ব রচনা","sol":["১২ এর দুটি উৎপাদক যাদের যোগফল ৭: ৩ ও ৪","x² − ৭x + ১২ = (x − ৩)(x − ৪)"],"kind":"math"},{"id":"bcs-bank-math-dbd663d7c3a3","subject":"গণিত","chapter":"বীজগণিত","q":"a = 7, b = 3 হলে (a + b)² − (a − b)² এর মান কত?","o":["১০০","৪০","৮৪","৫৮"],"a":2,"src":"নিজস্ব রচনা","sol":["(a + b)² − (a − b)² = 4ab = ৪ × ৭ × ৩ = ৮৪"],"kind":"math"},{"id":"bcs-bank-math-f24d7ef19ef5","subject":"গণিত","chapter":"বীজগণিত","q":"2x − 5 = 19 হলে x এর মান কত?","o":["৭","১০","১৪","১২"],"a":3,"src":"নিজস্ব রচনা","sol":["২x = ১৯ + ৫ = ২৪ ⇒ x = ১২"],"kind":"math"}]}