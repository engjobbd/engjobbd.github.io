{"pack":"bcs-bank-math","subject":"গণিত","chapter":"সূচক ও করণী","hash":"d44cb54b1be8","questions":[{"id":"bcs-bank-math-d59a8a9b28cd","subject":"গণিত","chapter":"সূচক ও করণী","q":"(27/125)^(−2/3) এর মান কত?","o":["25/9","5/3","9/25","3/5"],"a":0,"d":2,"src":"নিজস্ব রচনা","sol":["(27/125)^(−2/3) = (125/27)^(2/3) = ((5/3)³)^(2/3) = (5/3)² = 25/9"],"kind":"math"},{"id":"bcs-bank-math-45022370db24","subject":"গণিত","chapter":"সূচক ও করণী","q":"50 − {2(3 − 5)^(−3)}^(−2) এর মান কত?","o":["16","−34","34","66"],"a":2,"d":2,"src":"নিজস্ব রচনা","sol":["(3−5) = −2; (−2)^(−3) = −1/8","2 × (−1/8) = −1/4","(−1/4)^(−2) = 16","50 − 16 = 34"],"kind":"math"},{"id":"bcs-bank-math-141488825cc5","subject":"গণিত","chapter":"সূচক ও করণী","q":"(√2)^10 এর মান কত?","o":["64","16","32","25"],"a":2,"src":"নিজস্ব রচনা","sol":["(√2)^10 = (2^(1/2))^10 = 2^5 = 32"],"kind":"math"},{"id":"bcs-bank-math-001c1bcbdfa8","subject":"গণিত","chapter":"সূচক ও করণী","q":"(∛2 × ∛4)^6 এর মান কত?","o":["64","128","32","16"],"a":0,"src":"নিজস্ব রচনা","sol":["∛2 × ∛4 = ∛8 = 2","2^6 = 64"],"kind":"math"},{"id":"bcs-bank-math-2d4f0650e8b6","subject":"গণিত","chapter":"সূচক ও করণী","q":"(√2 × √8)^3 এর মান কত?","o":["256","32","16","64"],"a":3,"src":"নিজস্ব রচনা","sol":["√2 × √8 = √16 = 4","4³ = 64"],"kind":"math"},{"id":"bcs-bank-math-0ddb72fab288","subject":"গণিত","chapter":"সূচক ও করণী","q":"2^x = 32 হলে x² − 3x এর মান কত?","o":["−10","10","15","5"],"a":1,"src":"নিজস্ব রচনা","sol":["2^x = 2^5 ⇒ x = 5","x² − 3x = 25 − 15 = 10"],"kind":"math"}]}