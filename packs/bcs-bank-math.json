{"id":"bcs-bank-math","version":1,"title":"BCS ও ব্যাংক · গণিত (ম্যাথ সলভ)","category":"bcs","ch":{"গণিত|সূচক ও করণী":"d44cb54b1be8","গণিত|লগারিদম":"6d878d47d859","গণিত|শতকরা":"651106ce7dc9","গণিত|লাভ-ক্ষতি":"8645d7e164fb","গণিত|অনুপাত ও সমানুপাত":"3cbdfef7b1ac","গণিত|সময় ও কাজ":"d9c447a620c3","গণিত|গড়":"e59e17f3a8bf","গণিত|সরল মুনাফা":"09b46536d0c2","গণিত|বীজগণিত":"3199171f2928","গণিত|জ্যামিতি":"2fe658646907","গণিত|ধারা":"aa32c6298888","গণিত|গ.সা.গু ও ল.সা.গু":"a1caba2c9944","গণিত|বিন্যাস ও সমাবেশ":"2afcc8f14da0","গণিত|সম্ভাবনা":"6deb8044f331","গণিত|দশমিক ও বর্গমূল":"7821f6352d73"},"questions":[{"id":"bcs-bank-math-d59a8a9b28cd","subject":"গণিত","chapter":"সূচক ও করণী","q":"(27/125)^(−2/3) এর মান কত?","o":["25/9","5/3","9/25","3/5"],"a":0,"d":2,"src":"নিজস্ব রচনা","sol":["(27/125)^(−2/3) = (125/27)^(2/3) = ((5/3)³)^(2/3) = (5/3)² = 25/9"],"kind":"math"},{"id":"bcs-bank-math-45022370db24","subject":"গণিত","chapter":"সূচক ও করণী","q":"50 − {2(3 − 5)^(−3)}^(−2) এর মান কত?","o":["16","−34","34","66"],"a":2,"d":2,"src":"নিজস্ব রচনা","sol":["(3−5) = −2; (−2)^(−3) = −1/8","2 × (−1/8) = −1/4","(−1/4)^(−2) = 16","50 − 16 = 34"],"kind":"math"},{"id":"bcs-bank-math-141488825cc5","subject":"গণিত","chapter":"সূচক ও করণী","q":"(√2)^10 এর মান কত?","o":["64","16","32","25"],"a":2,"src":"নিজস্ব রচনা","sol":["(√2)^10 = (2^(1/2))^10 = 2^5 = 32"],"kind":"math"},{"id":"bcs-bank-math-001c1bcbdfa8","subject":"গণিত","chapter":"সূচক ও করণী","q":"(∛2 × ∛4)^6 এর মান কত?","o":["64","128","32","16"],"a":0,"src":"নিজস্ব রচনা","sol":["∛2 × ∛4 = ∛8 = 2","2^6 = 64"],"kind":"math"},{"id":"bcs-bank-math-2d4f0650e8b6","subject":"গণিত","chapter":"সূচক ও করণী","q":"(√2 × √8)^3 এর মান কত?","o":["256","32","16","64"],"a":3,"src":"নিজস্ব রচনা","sol":["√2 × √8 = √16 = 4","4³ = 64"],"kind":"math"},{"id":"bcs-bank-math-0ddb72fab288","subject":"গণিত","chapter":"সূচক ও করণী","q":"2^x = 32 হলে x² − 3x এর মান কত?","o":["−10","10","15","5"],"a":1,"src":"নিজস্ব রচনা","sol":["2^x = 2^5 ⇒ x = 5","x² − 3x = 25 − 15 = 10"],"kind":"math"},{"id":"bcs-bank-math-c058d7af745a","subject":"গণিত","chapter":"লগারিদম","q":"log₂ 32 এর মান কত?","o":["6","5","16","4"],"a":1,"src":"নিজস্ব রচনা","sol":["32 = 2^5 ⇒ log₂ 32 = 5"],"kind":"math"},{"id":"bcs-bank-math-797668a4422b","subject":"গণিত","chapter":"লগারিদম","q":"log₃ 81 + log₂ 8 এর মান কত?","o":["7","6","5","12"],"a":0,"src":"নিজস্ব রচনা","sol":["log₃ 81 = 4 (3⁴ = 81), log₂ 8 = 3","যোগফল = 7"],"kind":"math"},{"id":"bcs-bank-math-b43b0b710f0e","subject":"গণিত","chapter":"লগারিদম","q":"log₁₀ 5 + log₁₀ 2 এর মান কত?","o":["7","10","0","1"],"a":3,"src":"নিজস্ব রচনা","sol":["log 5 + log 2 = log(5 × 2) = log 10 = 1"],"kind":"math"},{"id":"bcs-bank-math-f5357a788bd5","subject":"গণিত","chapter":"শতকরা","q":"৪০০ টাকার ১২.৫% কত টাকা?","o":["৬২.৫ টাকা","৫০ টাকা","২৫ টাকা","৪০ টাকা"],"a":1,"src":"নিজস্ব রচনা","sol":["৪০০ × ১২.৫/১০০ = ৫০"],"kind":"math"},{"id":"bcs-bank-math-1cef21ec5843","subject":"গণিত","chapter":"শতকরা","q":"একটি সংখ্যার ৪০% = ৯৬ হলে সংখ্যাটি কত?","o":["২৪০","১৯২","৩৮৪","২৮৮"],"a":0,"src":"নিজস্ব রচনা","sol":["সংখ্যা × ৪০/১০০ = ৯৬","সংখ্যা = ৯৬ × ১০০/৪০ = ২৪০"],"kind":"math"},{"id":"bcs-bank-math-0bf0e77c1cfa","subject":"গণিত","chapter":"শতকরা","q":"দাম ২০% বাড়ার পর একটি জিনিসের দাম ৯০০ টাকা হলে আগের দাম কত ছিল?","o":["৭৫০ টাকা","৮০০ টাকা","১০৮০ টাকা","৭২০ টাকা"],"a":0,"d":2,"src":"নিজস্ব রচনা","sol":["আগের দাম × ১২০/১০০ = ৯০০","আগের দাম = ৯০০ × ১০০/১২০ = ৭৫০"],"kind":"math"},{"id":"bcs-bank-math-1cd71856e636","subject":"গণিত","chapter":"লাভ-ক্ষতি","q":"৮০০ টাকায় কিনে ৯২০ টাকায় বিক্রি করলে শতকরা লাভ কত?","o":["১৫%","২০%","১২%","১৬%"],"a":0,"src":"নিজস্ব রচনা","sol":["লাভ = ৯২০ − ৮০০ = ১২০","লাভ% = ১২০/৮০০ × ১০০ = ১৫%"],"kind":"math"},{"id":"bcs-bank-math-2409730e1e69","subject":"গণিত","chapter":"লাভ-ক্ষতি","q":"১৫% ক্ষতিতে একটি জিনিস ৫৯৫ টাকায় বিক্রি হলে ক্রয়মূল্য কত?","o":["৭৫০ টাকা","৭০০ টাকা","৬৮০ টাকা","৬৫০ টাকা"],"a":1,"d":2,"src":"নিজস্ব রচনা","sol":["ক্রয়মূল্য × ৮৫/১০০ = ৫৯৫","ক্রয়মূল্য = ৫৯৫ × ১০০/৮৫ = ৭০০"],"kind":"math"},{"id":"bcs-bank-math-b7097b8a40c8","subject":"গণিত","chapter":"লাভ-ক্ষতি","q":"১২টি কলা ১০ টাকায় কিনে ৮টি কলা ১০ টাকায় বিক্রি করলে শতকরা লাভ কত?","o":["২৫%","৫০%","৪০%","৩৩⅓%"],"a":1,"d":2,"src":"নিজস্ব রচনা","sol":["ধরি ক্রয় ২৪টি: খরচ ২০ টাকা","২৪টির বিক্রয় = ২৪/৮ × ১০ = ৩০ টাকা","লাভ% = ১০/২০ × ১০০ = ৫০%"],"kind":"math"},{"id":"bcs-bank-math-a7675c0c2ad9","subject":"গণিত","chapter":"অনুপাত ও সমানুপাত","q":"দুটি সংখ্যার অনুপাত ৩ : ৫ এবং যোগফল ১২০ হলে বড় সংখ্যাটি কত?","o":["৪৫","৬০","৮০","৭৫"],"a":3,"src":"নিজস্ব রচনা","sol":["মোট ভাগ = ৩ + ৫ = ৮","বড় সংখ্যা = ১২০ × ৫/৮ = ৭৫"],"kind":"math"},{"id":"bcs-bank-math-40136c19cc78","subject":"গণিত","chapter":"অনুপাত ও সমানুপাত","q":"A : B = 2 : 3 এবং B : C = 4 : 5 হলে A : C কত?","o":["২ : ৫","৮ : ১৫","৬ : ৫","৪ : ৫"],"a":1,"d":2,"src":"নিজস্ব রচনা","sol":["A : B = ২ × ৪ : ৩ × ৪ = ৮ : ১২","B : C = ১২ : ১৫ (৪ × ৩ : ৫ × ৩)","A : B : C = ৮ : ১২ : ১৫ ⇒ A : C = ৮ : ১৫"],"kind":"math"},{"id":"bcs-bank-math-4c5c2a729288","subject":"গণিত","chapter":"সময় ও কাজ","q":"৬ জন লোক একটি কাজ ১২ দিনে করতে পারে। ৯ জন লোক কাজটি কত দিনে করবে?","o":["৮ দিন","১৮ দিন","৬ দিন","১০ দিন"],"a":0,"src":"নিজস্ব রচনা","sol":["মোট কাজ = ৬ × ১২ = ৭২ জন-দিন","৯ জনে লাগবে = ৭২/৯ = ৮ দিন"],"kind":"math"},{"id":"bcs-bank-math-f0df91cbb608","subject":"গণিত","chapter":"গড়","q":"৫টি সংখ্যার গড় ২৪। একটি সংখ্যা বাদ দিলে বাকি চারটির গড় ২২ হয়। বাদ দেওয়া সংখ্যাটি কত?","o":["৩২","২৮","৪৪","৩৬"],"a":0,"d":2,"src":"নিজস্ব রচনা","sol":["৫টির যোগফল = ২৪ × ৫ = ১২০","৪টির যোগফল = ২২ × ৪ = ৮৮","বাদ দেওয়া সংখ্যা = ১২০ − ৮৮ = ৩২"],"kind":"math"},{"id":"bcs-bank-math-a26bb4808ce8","subject":"গণিত","chapter":"সরল মুনাফা","q":"৫০০০ টাকা বার্ষিক ৮% সরল মুনাফায় ৩ বছরে মুনাফা কত?","o":["১২০০ টাকা","১০০০ টাকা","১২৬৪ টাকা","১৬০০ টাকা"],"a":0,"src":"নিজস্ব রচনা","sol":["মুনাফা = ৫০০০ × ৮ × ৩/১০০ = ১২০০"],"kind":"math"},{"id":"bcs-bank-math-da609ec8d036","subject":"গণিত","chapter":"বীজগণিত","q":"x + 1/x = 4 হলে x² + 1/x² এর মান কত?","o":["১২","১৮","১৬","১৪"],"a":3,"d":2,"src":"নিজস্ব রচনা","sol":["x² + 1/x² = (x + 1/x)² − 2 = ১৬ − ২ = ১৪"],"kind":"math"},{"id":"bcs-bank-math-09d0da1c266c","subject":"গণিত","chapter":"বীজগণিত","q":"a − b = 3 এবং ab = 10 হলে a² + b² এর মান কত?","o":["৩৯","১৯","২৯","৪৯"],"a":2,"d":2,"src":"নিজস্ব রচনা","sol":["a² + b² = (a − b)² + 2ab = ৯ + ২০ = ২৯"],"kind":"math"},{"id":"bcs-bank-math-a9eb849b9a2d","subject":"গণিত","chapter":"বীজগণিত","q":"x² − 7x + 12 এর উৎপাদক কোনটি?","o":["(x − 3)(x − 4)","(x − 2)(x − 6)","(x − 1)(x − 12)","(x + 3)(x + 4)"],"a":0,"src":"নিজস্ব রচনা","sol":["১২ এর দুটি উৎপাদক যাদের যোগফল ৭: ৩ ও ৪","x² − ৭x + ১২ = (x − ৩)(x − ৪)"],"kind":"math"},{"id":"bcs-bank-math-dbd663d7c3a3","subject":"গণিত","chapter":"বীজগণিত","q":"a = 7, b = 3 হলে (a + b)² − (a − b)² এর মান কত?","o":["১০০","৪০","৮৪","৫৮"],"a":2,"src":"নিজস্ব রচনা","sol":["(a + b)² − (a − b)² = 4ab = ৪ × ৭ × ৩ = ৮৪"],"kind":"math"},{"id":"bcs-bank-math-f24d7ef19ef5","subject":"গণিত","chapter":"বীজগণিত","q":"2x − 5 = 19 হলে x এর মান কত?","o":["৭","১০","১৪","১২"],"a":3,"src":"নিজস্ব রচনা","sol":["২x = ১৯ + ৫ = ২৪ ⇒ x = ১২"],"kind":"math"},{"id":"bcs-bank-math-b854c4295bbd","subject":"গণিত","chapter":"জ্যামিতি","q":"একটি ত্রিভুজের দুটি কোণ ৫৫° ও ৭৫° হলে তৃতীয় কোণ কত?","o":["৫০°","৬০°","৫৫°","৪০°"],"a":0,"src":"নিজস্ব রচনা","sol":["তিন কোণের সমষ্টি ১৮০°","তৃতীয় কোণ = ১৮০° − (৫৫° + ৭৫°) = ৫০°"],"kind":"math"},{"id":"bcs-bank-math-9b8363dc41c1","subject":"গণিত","chapter":"জ্যামিতি","q":"একটি সমকোণী ত্রিভুজের অতিভুজ ২৫ সেমি এবং এক বাহু ১৫ সেমি হলে অপর বাহু কত?","o":["১৮ সেমি","২২ সেমি","২০ সেমি","১০ সেমি"],"a":2,"src":"নিজস্ব রচনা","sol":["পিথাগোরাস: ২৫² = ১৫² + x²","x² = ৬২৫ − ২২৫ = ৪০০ ⇒ x = ২০"],"kind":"math"},{"id":"bcs-bank-math-96354bd4bfc9","subject":"গণিত","chapter":"জ্যামিতি","q":"একটি বৃত্তের ব্যাসার্ধ ৭ সেমি হলে এর পরিধি কত? (π = 22/7)","o":["১৫৪ সেমি","২২ সেমি","৮৮ সেমি","৪৪ সেমি"],"a":3,"src":"নিজস্ব রচনা","sol":["পরিধি = ২πr = ২ × ২২/৭ × ৭ = ৪৪"],"kind":"math"},{"id":"bcs-bank-math-b786bb23edbc","subject":"গণিত","chapter":"জ্যামিতি","q":"একটি আয়তক্ষেত্রের দৈর্ঘ্য ১৬ মি. ও প্রস্থ ১২ মি. হলে কর্ণের দৈর্ঘ্য কত?","o":["১৮ মি.","১৪ মি.","২০ মি.","২৮ মি."],"a":2,"src":"নিজস্ব রচনা","sol":["কর্ণ = √(১৬² + ১২²) = √(২৫৬ + ১৪৪) = √৪০০ = ২০"],"kind":"math"},{"id":"bcs-bank-math-13fec2c62173","subject":"গণিত","chapter":"ধারা","q":"৩, ৯, ২৭, ৮১, ? ধারাটির পরের সংখ্যা কত?","o":["১৬২","১২১","২৪৪","২৪৩"],"a":3,"src":"নিজস্ব রচনা","sol":["প্রতিটি পদ আগেরটির ৩ গুণ","৮১ × ৩ = ২৪৩"],"kind":"math"},{"id":"bcs-bank-math-40bda4fd8eea","subject":"গণিত","chapter":"ধারা","q":"৫, ১১, ২৩, ৪৭, ? ধারাটির পরের সংখ্যা কত?","o":["৯৫","৯৪","৮৯","৯৩"],"a":0,"d":2,"src":"নিজস্ব রচনা","sol":["নিয়ম: আগের পদ × ২ + ১","৪৭ × ২ + ১ = ৯৫"],"kind":"math"},{"id":"bcs-bank-math-e48368504cab","subject":"গণিত","chapter":"ধারা","q":"১ থেকে ৫০ পর্যন্ত স্বাভাবিক সংখ্যার যোগফল কত?","o":["১২৫০","২৫৫০","১৩২৫","১২৭৫"],"a":3,"src":"নিজস্ব রচনা","sol":["যোগফল = n(n+1)/2 = ৫০ × ৫১/২ = ১২৭৫"],"kind":"math"},{"id":"bcs-bank-math-9ec698e5bf64","subject":"গণিত","chapter":"ধারা","q":"একটি সমান্তর ধারার প্রথম পদ ৪ এবং সাধারণ অন্তর ৩ হলে দশম পদ কত?","o":["৩১","২৮","৩৪","৩০"],"a":0,"src":"নিজস্ব রচনা","sol":["nতম পদ = a + (n−১)d = ৪ + ৯ × ৩ = ৩১"],"kind":"math"},{"id":"bcs-bank-math-91f3eb37ff42","subject":"গণিত","chapter":"গ.সা.গু ও ল.সা.গু","q":"১২, ১৮ ও ৩০ এর ল.সা.গু কত?","o":["৯০","১৮০","৩৬","৩৬০"],"a":1,"src":"নিজস্ব রচনা","sol":["১২ = ২²×৩, ১৮ = ২×৩², ৩০ = ২×৩×৫","ল.সা.গু = ২² × ৩² × ৫ = ১৮০"],"kind":"math"},{"id":"bcs-bank-math-69eafeec4beb","subject":"গণিত","chapter":"গ.সা.গু ও ল.সা.গু","q":"১৬ ও ২৪ এর গ.সা.গু কত?","o":["১২","৪৮","৪","৮"],"a":3,"src":"নিজস্ব রচনা","sol":["১৬ = ২⁴, ২৪ = ২³×৩","গ.সা.গু = ২³ = ৮"],"kind":"math"},{"id":"bcs-bank-math-1f2cca7c0132","subject":"গণিত","chapter":"বিন্যাস ও সমাবেশ","q":"৫ জন থেকে ৩ জনের একটি কমিটি কত উপায়ে গঠন করা যায়?","o":["১৫","১০","৬০","২০"],"a":1,"src":"নিজস্ব রচনা","sol":["⁵C₃ = ৫!/(৩! × ২!) = ১০"],"kind":"math"},{"id":"bcs-bank-math-29b484fc0113","subject":"গণিত","chapter":"সম্ভাবনা","q":"একটি পাশা একবার নিক্ষেপ করলে জোড় সংখ্যা ওঠার সম্ভাবনা কত?","o":["১/৩","২/৩","১/৬","১/২"],"a":3,"src":"নিজস্ব রচনা","sol":["জোড় সংখ্যা: ২, ৪, ৬ = ৩টি","মোট ফল ৬টি ⇒ সম্ভাবনা = ৩/৬ = ১/২"],"kind":"math"},{"id":"bcs-bank-math-1ac39c337766","subject":"গণিত","chapter":"দশমিক ও বর্গমূল","q":"√1.44 এর মান কত?","o":["১.৪","০.১২","১.২","১.১৪"],"a":2,"src":"নিজস্ব রচনা","sol":["১.৪৪ = ১২²/১০² = (১.২)² ⇒ √১.৪৪ = ১.২"],"kind":"math"},{"id":"bcs-bank-math-455269359728","subject":"গণিত","chapter":"দশমিক ও বর্গমূল","q":"০.২ × ০.০৩ = কত?","o":["০.০৬","০.০০০৬","০.৬","০.০০৬"],"a":3,"src":"নিজস্ব রচনা","sol":["২ × ৩ = ৬; দশমিকের পরে ১ + ২ = ৩ ঘর","= ০.০০৬"],"kind":"math"}]}